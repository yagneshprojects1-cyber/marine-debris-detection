# ==============================================================
#  Debris Detector - root .gitignore
# ==============================================================

# ── Node / React frontend ─────────────────────────────────────
node_modules/
frontend/build/
frontend/dist/
coverage/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment files & secrets ───────────────────────────────
.env
.env.*
!.env.example

# ── Python backend ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ── Runtime data (uploads, annotated images, generated output) ─
backend/data/
geotag_calculated.json
*_detection_report.json

# ── Model weights (large binary - use Git LFS if required) ────
*.pt

# ── Logs ──────────────────────────────────────────────────────
*.log

# ── OS generated files ────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editor / IDE ──────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
